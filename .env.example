# ProofLab environment. Copy to .env.local. Do not commit real secrets.
# .env.local is gitignored. This file is the template.

# Public App ID from https://dev.primuslabs.xyz/myDevelopment/myProjects
# Safe to expose. Must be the same project as PRIMUS_APP_ID.
NEXT_PUBLIC_PRIMUS_APP_ID=

# Optional template UUID prefilled in the browser. From the marketplace or your project.
# https://dev.primuslabs.xyz/marketplace
NEXT_PUBLIC_DEFAULT_TEMPLATE_ID=

# Server-only. Same App ID as NEXT_PUBLIC_PRIMUS_APP_ID.
PRIMUS_APP_ID=

# Server-only. Dev Hub App Secret. The JS SDK signs with it as an ethers private key.
# Never prefix this with NEXT_PUBLIC_.
PRIMUS_APP_SECRET=

# Optional server-side template prefill. Used when the public default above is empty.
DEFAULT_ATT_TEMPLATE_ID=

# Optional. Base URL of a self-hosted DVC service (primus-labs/DVC-Demo dvc-service).
# That process implements POST /submitTask and GET /getResult?task_id=.
# Leave empty to keep the computation panel in the Unavailable state.
# DVC-Demo's own example is http://localhost:38080. There is no public hosted prover
# in the current DVC-Demo .env.example. dvcapi.primuslabs.xyz does not resolve.
# DVC_SERVICE_URL=http://127.0.0.1:38080
DVC_SERVICE_URL=

# Optional. UUID returned by that service's POST /uploadProgram. Not a secret.
# Prefills program_id. Leave empty to type the id into the form.
# The ELF behind this id must match the attestation_data shape you submit:
# network-succinct for HASH_COMPARSION / AES_DECRYPTION, or zktls-att-verification
# main for an enterprise ciphertext attestation plus aes_key.
DVC_PROGRAM_ID=
